<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="p-8 bg-gray-100">

  <h1 class="text-2xl font-bold mb-4">
    Welcome <%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Admin' %>
  </h1>

  <h2 class="text-xl font-semibold mb-2">Products</h2>
  <ul class="list-disc pl-6 mb-4">
    <% if (products && products.length > 0) { %>
      <% products.forEach(product => { %>
        <li>
          <strong><%= product.name %></strong> - <%= product.points %> points
          <a href="/admin/product/<%= product._id %>/generate" class="ml-2 text-blue-600">Generate Coupon</a>
        </li>
      <% }) %>
    <% } else { %>
      <li>No products found</li>
    <% } %>
  </ul>

  <a href="/admin/product/add" class="inline-block mt-4 px-4 py-2 bg-green-600 text-white rounded">Add New Product</a>

  <h2 class="text-xl font-semibold mt-8 mb-2">Quick Links</h2>
  <ul class="list-disc pl-6">
    <li><a href="/admin/coupons" class="text-blue-600">View All Coupons</a></li>
    <li><a href="/admin/customers" class="text-blue-600">View Customers</a></li>
  </ul>

</body>
</html>
