<h1>Admin Dashboard</h1>
<p>Welcome, <%= user.name %></p>

<h2>Products</h2>
<ul>
  <% if (products && products.length > 0) { %>
    <% products.forEach(product => { %>
      <li><strong><%= product.name %></strong> - <%= product.points %> points</li>
    <% }) %>
  <% } else { %>
    <li>No products found</li>
  <% } %>
</ul>

<h2>Coupons</h2>
<a href="/admin/add-coupon">Add New Coupon</a>
<ul>
  <% if (coupons && coupons.length > 0) { %>
    <% coupons.forEach(coupon => { %>
      <li>
        <strong><%= coupon.code %></strong> - <%= coupon.points %> points - 
        <%= coupon.product ? coupon.product.name : 'No product' %> - 
        <%= coupon.isRedeemed ? 'Redeemed' : 'Available' %>
      </li>
    <% }) %>
  <% } else { %>
    <li>No coupons found</li>
  <% } %>
</ul>
