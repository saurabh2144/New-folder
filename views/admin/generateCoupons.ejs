<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Generate Coupons</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="p-8 bg-gray-100">

  <h1 class="text-2xl font-bold mb-4">Generate Coupons for <%= product.name %></h1>

  <form action="/admin/product/<%= product._id %>/generate" method="POST" class="space-y-4">
    <div>
      <label class="block font-semibold">Number of Coupons:</label>
      <input type="number" name="count" value="1" required class="border p-2 rounded w-full">
    </div>
    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded">Generate</button>
  </form>

  <a href="/admin" class="inline-block mt-4 text-blue-600">Back to Dashboard</a>

</body>
</html>
