<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Coupons List</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="p-8 bg-gray-100">

  <h1 class="text-2xl font-bold mb-4">Coupons for <%= product ? product.name : 'All Products' %></h1>

  <ul class="list-disc pl-6">
    <% if (coupons && coupons.length > 0) { %>
      <% coupons.forEach(item => { %>
        <li class="mb-2">
          <strong><%= item.coupon.code %></strong> - <%= item.coupon.points %> points - 
          <% if (item.coupon.isRedeemed) { %>
            <span class="text-red-600">Redeemed</span>
          <% } else { %>
            <span class="text-green-600">Available</span>
          <% } %>
          <br>
          <img src="<%= item.qrDataUrl %>" alt="QR Code" width="100">
        </li>
      <% }) %>
    <% } else { %>
      <li>No coupons found</li>
    <% } %>
  </ul>

  <a href="/admin" class="inline-block mt-4 text-blue-600">Back to Dashboard</a>

</body>
</html>
