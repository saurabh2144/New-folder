<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Redeem Coupon</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="p-8 bg-gray-100">

  <h1 class="text-2xl font-bold mb-4">Redeem Coupon for <%= product.name %></h1>

  <form action="/redeem/send-otp" method="POST" class="space-y-4">
    <div>
      <label class="block font-semibold">Enter Your Phone Number:</label>
      <input type="text" name="phone" required class="border p-2 rounded w-full">
    </div>
    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded">Send OTP</button>
  </form>

</body>
</html>
