<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Redeem Result</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.3/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex items-center justify-center h-screen bg-gray-100">
  <div class="bg-white p-8 rounded shadow-md w-full max-w-md text-center">
    <% if (success) { %>
      <h1 class="text-2xl font-bold text-green-600 mb-4"><%= title %></h1>
      <p class="mb-4"><%= message %></p>
    <% } else { %>
      <h1 class="text-2xl font-bold text-red-600 mb-4"><%= title %></h1>
      <p class="mb-4"><%= message %></p>
    <% } %>
    <a href="/redeem" class="inline-block mt-4 bg-blue-600 text-white p-2 rounded hover:bg-blue-700">Try Again</a>
  </div>
</body>
</html>
