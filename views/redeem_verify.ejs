<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Verify OTP</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="p-8 bg-gray-100">

  <h1 class="text-2xl font-bold mb-4">Verify OTP for <%= phone %></h1>

  <form action="/redeem/verify" method="POST" class="space-y-4">
    <div>
      <label class="block font-semibold">Enter OTP:</label>
      <input type="text" name="otp" required class="border p-2 rounded w-full">
    </div>
    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded">Verify & Redeem</button>
  </form>

</body>
</html>
